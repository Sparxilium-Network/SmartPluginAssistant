<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.chiliasmstudio.smartpluginassistant.controller.ModrinthBrowserController"
      spacing="12.0" prefWidth="680.0" prefHeight="560.0" style="-fx-background-color: #1e1f22; -fx-padding: 16;">

    <HBox spacing="10.0" alignment="CENTER_LEFT">
        <Label text="Modrinth 插件中心" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #ffffff;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <ProgressIndicator fx:id="loadingIndicator" prefWidth="20" prefHeight="20" visible="false"/>
    </HBox>

    <!-- Filter Bar -->
    <HBox spacing="10.0" alignment="CENTER_LEFT">
        <TextField fx:id="searchField" promptText="搜尋插件名稱或關鍵字 (例如: viaversion, essentials...)" HBox.hgrow="ALWAYS" onAction="#handleSearch"/>
        <ComboBox fx:id="loaderFilterCombo" prefWidth="120"/>
        <ComboBox fx:id="versionFilterCombo" prefWidth="110"/>
        <Button text="搜尋" onAction="#handleSearch" styleClass="btn-primary"/>
    </HBox>

    <HBox alignment="CENTER_LEFT">
        <Label fx:id="statusLabel" text="準備就緒" style="-fx-text-fill: #8b8e96; -fx-font-size: 12px;"/>
    </HBox>

    <!-- Results List -->
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background: #18191c; -fx-background-color: #18191c;">
        <VBox fx:id="resultsContainer" spacing="10.0" style="-fx-padding: 8;"/>
    </ScrollPane>
</VBox>
