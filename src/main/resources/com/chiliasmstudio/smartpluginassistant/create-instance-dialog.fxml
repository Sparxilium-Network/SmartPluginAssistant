<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.chiliasmstudio.smartpluginassistant.controller.CreateInstanceDialogController"
      spacing="14.0" prefWidth="440.0" style="-fx-background-color: #1e1f22; -fx-padding: 20;">

    <Label text="建立新伺服器實例" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #ffffff;"/>
    <Label text="此操作僅用於建立插件管理環境，並非架設後台伺服器程序。" style="-fx-text-fill: #8b8e96; -fx-font-size: 12px;" wrapText="true"/>

    <Separator style="-fx-background-color: #2e3136;"/>

    <VBox spacing="6.0">
        <Label text="實例名稱:" style="-fx-text-fill: #dfe1e5; -fx-font-weight: bold;"/>
        <TextField fx:id="nameField" promptText="例如: 生存服 1.21.1"/>
    </VBox>

    <HBox spacing="12.0">
        <VBox spacing="6.0" HBox.hgrow="ALWAYS">
            <Label text="伺服器核心 (Loader):" style="-fx-text-fill: #dfe1e5; -fx-font-weight: bold;"/>
            <ComboBox fx:id="loaderComboBox" maxWidth="Infinity"/>
        </VBox>
        <VBox spacing="6.0" HBox.hgrow="ALWAYS">
            <Label text="Minecraft 版本:" style="-fx-text-fill: #dfe1e5; -fx-font-weight: bold;"/>
            <ComboBox fx:id="versionComboBox" maxWidth="Infinity"/>
        </VBox>
    </HBox>

    <VBox spacing="6.0">
        <Label text="自訂伺服器路徑 (選填，若已有現成目錄請指定):" style="-fx-text-fill: #dfe1e5;"/>
        <HBox spacing="8.0">
            <TextField fx:id="customDirField" promptText="預設在 AppData/instances/..." HBox.hgrow="ALWAYS"/>
            <Button fx:id="browseDirBtn" text="瀏覽..." onAction="#handleBrowseDir" styleClass="btn-secondary"/>
        </HBox>
    </VBox>

    <Region VBox.vgrow="ALWAYS"/>

    <HBox spacing="10.0" alignment="CENTER_RIGHT">
        <Button text="取消" onAction="#handleCancel" styleClass="btn-secondary"/>
        <Button text="建立實例" onAction="#handleCreate" styleClass="btn-primary"/>
    </HBox>
</VBox>
