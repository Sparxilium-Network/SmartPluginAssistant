<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:id="rootPane"
      fx:controller="com.sparxilium.smartpluginassistant.controller.VoxelBrowserController"
      spacing="12.0" prefWidth="1080.0" prefHeight="720.0" style="-fx-background-color: #1e1f22; -fx-padding: 16;">

    <HBox spacing="10.0" alignment="CENTER_LEFT">
        <Label fx:id="titleLabel" text="Voxel.shop 資源中心" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #ffffff;"/>
        <Hyperlink fx:id="apiByLink" text="API BY VOXEL.SHOP" onAction="#handleOpenApiWebPage" styleClass="api-by-link, api-by-voxel"/>
        <Region HBox.hgrow="ALWAYS"/>
        <ProgressIndicator fx:id="loadingIndicator" prefWidth="20" prefHeight="20" visible="false"/>
    </HBox>

    <!-- Filter Bar -->
    <HBox spacing="10.0" alignment="CENTER_LEFT">
        <TextField fx:id="searchField" promptText="搜尋 Voxel.shop 插件或資源名稱 (例如: essentials, dragontpa...)" HBox.hgrow="ALWAYS" onAction="#handleSearch"/>
        <ComboBox fx:id="priceFilterCombo" prefWidth="130"/>
        <Button fx:id="searchBtn" text="搜尋" onAction="#handleSearch" styleClass="btn-primary"/>
    </HBox>

    <HBox alignment="CENTER_LEFT">
        <Label fx:id="statusLabel" text="準備就緒" style="-fx-text-fill: #8b8e96; -fx-font-size: 12px;"/>
    </HBox>

    <SplitPane dividerPositions="0.65" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
        <!-- Left Side: Results List -->
        <ScrollPane fx:id="resultsScrollPane" fitToWidth="true" style="-fx-background: #18191c; -fx-background-color: #18191c;">
            <VBox fx:id="resultsContainer" spacing="10.0" style="-fx-padding: 8;"/>
        </ScrollPane>

        <!-- Right Side: Details View -->
        <VBox fx:id="detailContainer" spacing="14.0" style="-fx-padding: 14; -fx-background-color: #2b2d30; -fx-background-radius: 6;" visible="false">
            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                    <Label fx:id="detailTitleLabel" text="標題" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #ffffff;" wrapText="true"/>
                    <Label fx:id="detailAuthorLabel" text="作者" style="-fx-text-fill: #8b8e96; -fx-font-size: 12px;"/>
                </VBox>
                <Button fx:id="openInBrowserBtn" text="🌐 在瀏覽器中開啟" onAction="#handleOpenWebPage" styleClass="btn-secondary"/>
            </HBox>

            <Separator style="-fx-background-color: #393b40;"/>

            <HBox spacing="8.0" alignment="CENTER_LEFT">
                <Label fx:id="detailPriceBadge" style="-fx-font-weight: bold; -fx-padding: 3 8; -fx-background-radius: 4; -fx-font-size: 12px;"/>
                <Label fx:id="detailPlatformsLabel" style="-fx-text-fill: #bcbec4; -fx-font-size: 12px;"/>
            </HBox>

            <Label fx:id="detailVersionsLabel" style="-fx-text-fill: #8b8e96; -fx-font-size: 11px;" wrapText="true"/>

            <VBox spacing="6.0">
                <Button fx:id="detailDownloadBtn" text="下載" onAction="#handleDownloadOrBuy" maxWidth="Infinity" styleClass="btn-primary" prefHeight="38.0"/>
            </VBox>

            <Separator style="-fx-background-color: #393b40;"/>

            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background: transparent; -fx-background-color: transparent;">
                <Label fx:id="detailDescLabel" text="簡介" style="-fx-text-fill: #dfe1e5; -fx-font-size: 13px; -fx-line-spacing: 4px;" wrapText="true"/>
            </ScrollPane>
        </VBox>
    </SplitPane>

</VBox>
