<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.sparxilium.smartpluginassistant.controller.AppSettingsDialogController"
      spacing="14.0" prefWidth="480.0" style="-fx-background-color: #1e1f22; -fx-padding: 20;">

    <Label fx:id="titleLabel" text="應用程式設定" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #ffffff;"/>

    <Separator style="-fx-background-color: #2e3136;"/>

    <!-- Language Section -->
    <VBox spacing="6.0">
        <Label fx:id="langLabel" text="介面語言 (Language):" style="-fx-text-fill: #dfe1e5; -fx-font-weight: bold;"/>
        <ComboBox fx:id="langComboBox" maxWidth="Infinity"/>
    </VBox>

    <Separator style="-fx-background-color: #2e3136;"/>

    <!-- Cache Management Section -->
    <VBox spacing="10.0" style="-fx-background-color: #26282c; -fx-padding: 12; -fx-background-radius: 6; -fx-border-color: #393b40; -fx-border-radius: 6;">
        <Label fx:id="cacheSectionLabel" text="快取管理 (Cache Management):" style="-fx-text-fill: #ffffff; -fx-font-weight: bold;"/>
        <Label fx:id="cacheSizeLabel" text="目前圖片快取大小: 0 B" style="-fx-text-fill: #8b8e96; -fx-font-size: 12px;"/>
        <HBox alignment="CENTER_LEFT">
            <Button fx:id="clearCacheBtn" text="🗑️ 清除所有快取" onAction="#handleClearCache" styleClass="btn-danger"/>
        </HBox>
    </VBox>

    <Region VBox.vgrow="ALWAYS"/>

    <HBox spacing="10.0" alignment="CENTER_RIGHT">
        <Button fx:id="closeBtn" text="關閉" onAction="#handleClose" styleClass="btn-primary"/>
    </HBox>
</VBox>
