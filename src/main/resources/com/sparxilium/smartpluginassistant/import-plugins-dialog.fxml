<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.sparxilium.smartpluginassistant.controller.ImportPluginsDialogController"
      spacing="14.0" prefWidth="860.0" prefHeight="620.0" style="-fx-background-color: #1e1f22; -fx-padding: 20;">

    <Label fx:id="titleLabel" text="批量匯入插件" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #ffffff;"/>
    <Label fx:id="hintLabel" text="選擇包含 .jar 插件檔案的目錄，系統將自動讀取並盡可能連結至 Modrinth 元數據。" style="-fx-text-fill: #8b8e96; -fx-font-size: 12px;" wrapText="true"/>

    <!-- Directory selection bar -->
    <HBox spacing="8.0" alignment="CENTER_LEFT">
        <TextField fx:id="folderPathField" promptText="請選擇或輸入包含插件的目錄路徑..." HBox.hgrow="ALWAYS" editable="false"/>
        <Button fx:id="browseFolderBtn" text="📂 瀏覽目錄" onAction="#handleBrowseFolder" styleClass="btn-primary"/>
        <Button fx:id="rescanBtn" text="重新掃描" onAction="#handleRescan" styleClass="btn-secondary"/>
    </HBox>

    <!-- Table of discovered plugins -->
    <TableView fx:id="importTableView" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colSelect" prefWidth="48.0" style="-fx-alignment: CENTER;" resizable="false"/>
            <TableColumn fx:id="colFilename" text="檔案名稱" prefWidth="250.0"/>
            <TableColumn fx:id="colSize" text="檔案大小" prefWidth="90.0"/>
            <TableColumn fx:id="colDetected" text="內部資訊" prefWidth="180.0"/>
            <TableColumn fx:id="colModrinth" text="Modrinth 連結狀態" prefWidth="240.0"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

    <!-- Selection operations & Status bar -->
    <HBox spacing="10.0" alignment="CENTER_LEFT">
        <Button fx:id="selectAllBtn" text="全選" onAction="#handleSelectAll" styleClass="btn-secondary" style="-fx-font-size: 11px; -fx-padding: 4 8;"/>
        <Button fx:id="deselectAllBtn" text="全部取消" onAction="#handleDeselectAll" styleClass="btn-secondary" style="-fx-font-size: 11px; -fx-padding: 4 8;"/>
        <Label fx:id="statusLabel" text="請選擇目錄" style="-fx-text-fill: #8b8e96; -fx-font-size: 12px;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <ProgressIndicator fx:id="progressIndicator" prefWidth="20" prefHeight="20" visible="false"/>
    </HBox>

    <!-- Bottom Action Buttons -->
    <HBox spacing="12.0" alignment="CENTER_RIGHT">
        <Button fx:id="closeBtn" text="關閉" onAction="#handleClose" styleClass="btn-secondary"/>
        <Button fx:id="startImportBtn" text="開始匯入選取項目" onAction="#handleStartImport" styleClass="btn-success"/>
    </HBox>
</VBox>
