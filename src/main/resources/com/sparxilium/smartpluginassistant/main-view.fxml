<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:id="rootPane"
            fx:controller="com.sparxilium.smartpluginassistant.controller.MainController"
            prefHeight="720.0" prefWidth="1080.0">

    <!-- Top Action Bar (Prism-like) -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="top-bar">
            <Label fx:id="appTitleLabel" text="Smart Plugin Assistant" styleClass="app-title"/>
            <Label fx:id="appSubtitleLabel" text="伺服器插件管理器" style="-fx-text-fill: #8b8e96; -fx-font-size: 12px;"/>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- App Global Settings Button -->
            <Button fx:id="appSettingsBtn" text="⚙️ 設定" onAction="#handleOpenAppSettings" styleClass="btn-secondary"/>

            <Button fx:id="addInstanceBtn" text="+ 新增伺服器實例" onAction="#handleCreateInstance" styleClass="btn-primary"/>
        </HBox>
    </top>

    <center>
        <SplitPane dividerPositions="0.25" style="-fx-background-color: transparent;">
            <!-- Left Instances Panel -->
            <VBox spacing="10.0" styleClass="sidebar">
                <HBox alignment="CENTER_LEFT">
                    <Label fx:id="instanceListHeaderLabel" text="伺服器實例清單" style="-fx-text-fill: #bcbec4; -fx-font-weight: bold;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="refreshInstancesBtn" text="重整" onAction="#refreshInstanceList" styleClass="btn-secondary" style="-fx-font-size: 11px; -fx-padding: 3 8;"/>
                </HBox>

                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background: #1e1f22; -fx-background-color: #1e1f22;">
                    <FlowPane fx:id="instanceContainer" hgap="10.0" vgap="10.0" style="-fx-padding: 4;"/>
                </ScrollPane>
            </VBox>

            <!-- Right Instance Detail & Plugin Manager -->
            <VBox fx:id="instanceDetailPanel" spacing="14.0" style="-fx-padding: 16; -fx-background-color: #18191c;">
                <!-- Instance Header -->
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                        <Label fx:id="selectedInstanceNameLabel" text="未選擇實例" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #ffffff;"/>
                        <Label fx:id="selectedInstanceInfoLabel" text="請從左側選擇或建立一個伺服器實例" style="-fx-text-fill: #8b8e96; -fx-font-size: 12px;"/>
                    </VBox>
                    <Button fx:id="instanceSettingsBtn" text="⚙️ 實例設定" onAction="#handleOpenInstanceSettings" styleClass="btn-secondary"/>
                    <Button fx:id="openPluginsFolderBtn" text="開啟插件資料夾" onAction="#handleOpenPluginsFolder" styleClass="btn-secondary"/>
                    <Button fx:id="exportZipBtn" text="📦 匯出為 ZIP" onAction="#handleExportInstanceZip" styleClass="btn-secondary"/>
                    <Button fx:id="deleteInstanceBtn" text="刪除實例" onAction="#handleDeleteCurrentInstance" styleClass="btn-danger"/>
                </HBox>

                <!-- Plugin Actions Toolbar -->
                <HBox alignment="CENTER_LEFT" spacing="8.0" style="-fx-background-color: #2b2d30; -fx-padding: 8 10; -fx-background-radius: 6;">
                    <Button fx:id="browseModrinthBtn" text="🔍 瀏覽 Modrinth 插件" onAction="#handleOpenModrinthBrowser" styleClass="btn-primary"/>
                    <Button fx:id="addByUrlBtn" text="🔗 貼上網址新增" onAction="#handleAddByUrl" styleClass="btn-secondary"/>
                    <Button fx:id="importPluginsBtn" text="📂 匯入插件" onAction="#handleOpenImportPlugins" styleClass="btn-secondary"/>
                    <Button fx:id="checkUpdatesBtn" text="🔄 檢查所有更新" onAction="#handleCheckUpdates" styleClass="btn-secondary"/>
                    <Button fx:id="updateAllBtn" text="⚡ 一鍵全部更新" onAction="#handleUpdateAll" styleClass="btn-success" visible="false"/>
                    <Button fx:id="refreshPluginsBtn" text="重整清單" onAction="#refreshPlugins" styleClass="btn-secondary"/>

                    <Separator orientation="VERTICAL" style="-fx-background-color: #393b40;"/>

                    <!-- Local Plugin Search and State Filters -->
                    <TextField fx:id="pluginSearchField" promptText="搜尋本機插件名稱..." prefWidth="160" style="-fx-font-size: 11px;"/>
                    <ComboBox fx:id="pluginFilterCombo" prefWidth="130" style="-fx-font-size: 11px;"/>

                    <Separator orientation="VERTICAL" style="-fx-background-color: #393b40;"/>

                    <Button fx:id="batchEnableBtn" text="啟用選取" onAction="#handleBatchEnable" styleClass="btn-secondary"/>
                    <Button fx:id="batchDisableBtn" text="停用選取" onAction="#handleBatchDisable" styleClass="btn-secondary"/>
                    <Button fx:id="batchDeleteBtn" text="🗑️ 刪除選取" onAction="#handleBatchDelete" styleClass="btn-danger"/>

                    <Region HBox.hgrow="ALWAYS"/>
                    <ProgressIndicator fx:id="globalProgress" prefWidth="20" prefHeight="20" visible="false"/>
                </HBox>

                <!-- Plugins Table View -->
                <TableView fx:id="pluginTableView" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colSelect" prefWidth="48.0" style="-fx-alignment: CENTER;" resizable="false"/>
                        <TableColumn fx:id="colName" text="檔案名稱 / 插件" prefWidth="300.0"/>
                        <TableColumn fx:id="colCurrentVersion" text="目前版本" prefWidth="140.0"/>
                        <TableColumn fx:id="colLastModified" text="最後修改時間" prefWidth="180.0"/>
                        <TableColumn fx:id="colUpdate" text="版本狀態" prefWidth="180.0"/>
                        <TableColumn fx:id="colActions" text="操作" prefWidth="100.0"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>

                <!-- Footer Status Bar -->
                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <Label fx:id="statusLabel" text="就緒" style="-fx-text-fill: #8b8e96; -fx-font-size: 12px;"/>
                </HBox>
            </VBox>
        </SplitPane>
    </center>
</BorderPane>
