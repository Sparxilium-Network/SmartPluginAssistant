<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.sparxilium.smartpluginassistant.controller.InstanceSettingsDialogController"
      spacing="14.0" prefWidth="580.0" style="-fx-background-color: #1e1f22; -fx-padding: 20;">

    <Label fx:id="titleLabel" text="伺服器實例設定" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #ffffff;"/>
    <Label fx:id="instanceNameLabel" style="-fx-text-fill: #3574f0; -fx-font-weight: bold; -fx-font-size: 13px;"/>

    <Separator style="-fx-background-color: #2e3136;"/>

    <HBox spacing="12.0">
        <VBox spacing="6.0" HBox.hgrow="ALWAYS">
            <Label fx:id="loaderLabel" text="伺服器核心 (Loader):" style="-fx-text-fill: #dfe1e5; -fx-font-weight: bold;"/>
            <ComboBox fx:id="loaderComboBox" maxWidth="Infinity"/>
        </VBox>
        <VBox spacing="6.0" HBox.hgrow="ALWAYS">
            <Label fx:id="versionLabel" text="Minecraft 版本:" style="-fx-text-fill: #dfe1e5; -fx-font-weight: bold;"/>
            <ComboBox fx:id="versionComboBox" maxWidth="Infinity"/>
        </VBox>
    </HBox>

    <Separator style="-fx-background-color: #2e3136;"/>

    <!-- Granular Compatibility Options Section -->
    <VBox spacing="8.0" style="-fx-background-color: #26282c; -fx-padding: 12; -fx-background-radius: 6; -fx-border-color: #393b40; -fx-border-radius: 6;">
        <Label fx:id="compatSectionLabel" text="額外載入器相容性 (Compatibility Selection):" style="-fx-text-fill: #ffffff; -fx-font-weight: bold;"/>

        <!-- Dynamic CheckBoxes for Available Compatible Loaders -->
        <VBox fx:id="checkBoxesContainer" spacing="6.0" style="-fx-padding: 4 0 4 6;"/>

        <Label fx:id="warningLabel"
               text="⚠️ 警告：勾選額外相容載入器後，部分非原生開發之插件可能存在 API 差異、非同步問題或效能衝突，使用前請注意相容性風險！"
               style="-fx-text-fill: #e67e22; -fx-font-size: 11px; -fx-font-weight: bold;" wrapText="true" visible="false" managed="false"/>
    </VBox>

    <!-- Pre-release (Beta / Alpha) Settings Section -->
    <VBox spacing="6.0" style="-fx-background-color: #26282c; -fx-padding: 12; -fx-background-radius: 6; -fx-border-color: #393b40; -fx-border-radius: 6;">
        <CheckBox fx:id="allowPrereleaseCheckBox" text="允許測試版本 (Alpha / Beta) 檢查與更新" style="-fx-text-fill: #ffffff; -fx-font-weight: bold;"/>
        <Label fx:id="allowPrereleaseHintLabel" text="開啟後，檢查更新時將允許檢測並升級至最新的 Alpha / Beta 測試版本。" style="-fx-text-fill: #8b8e96; -fx-font-size: 11px;" wrapText="true"/>
    </VBox>

    <!-- Higher Minecraft Version Compatibility Settings Section -->
    <VBox spacing="6.0" style="-fx-background-color: #26282c; -fx-padding: 12; -fx-background-radius: 6; -fx-border-color: #393b40; -fx-border-radius: 6;">
        <CheckBox fx:id="allowHigherMcVersionsCheckBox" text="允許更高 MC 版本相容" style="-fx-text-fill: #ffffff; -fx-font-weight: bold;"/>
        <Label fx:id="allowHigherMcVersionsHintLabel" text="開啟後，檢查更新時將允許檢測適用於更高 Minecraft 版本的插件更新。" style="-fx-text-fill: #8b8e96; -fx-font-size: 11px;" wrapText="true"/>
    </VBox>

    <!-- Platform API Tokens Section -->
    <VBox spacing="10.0" style="-fx-background-color: #26282c; -fx-padding: 12; -fx-background-radius: 6; -fx-border-color: #393b40; -fx-border-radius: 6;">
        <Label fx:id="apiTokensSectionLabel" text="平台 API 金鑰與 Token 設定 (API Access Tokens):" style="-fx-text-fill: #ffffff; -fx-font-weight: bold;"/>
        <Label fx:id="apiTokensHintLabel" text="設定私有金鑰或個人存取權杖，可用於提升 API 請求頻率限制 (Rate Limit) 或存取受權限保護之資源。" style="-fx-text-fill: #8b8e96; -fx-font-size: 11px;" wrapText="true"/>

        <GridPane hgap="10.0" vgap="8.0">
            <columnConstraints>
                <ColumnConstraints minWidth="130" prefWidth="150"/>
                <ColumnConstraints hgrow="ALWAYS"/>
            </columnConstraints>

            <!-- Modrinth -->
            <Label fx:id="tokenModrinthLabel" text="Modrinth Token:" style="-fx-text-fill: #dfe1e5;" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <PasswordField fx:id="tokenModrinthField" promptText="Modrinth Personal Access Token" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <!-- Hangar -->
            <Label fx:id="tokenHangarLabel" text="Hangar API Key:" style="-fx-text-fill: #dfe1e5;" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <PasswordField fx:id="tokenHangarField" promptText="PaperMC Hangar API Key" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <!-- Voxel.shop -->
            <Label fx:id="tokenVoxelLabel" text="Voxel.shop Token:" style="-fx-text-fill: #dfe1e5;" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <PasswordField fx:id="tokenVoxelField" promptText="Voxel.shop / Polymart API Key" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

            <!-- Spiget -->
            <Label fx:id="tokenSpigetLabel" text="Spiget User-Agent / Token:" style="-fx-text-fill: #dfe1e5;" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <PasswordField fx:id="tokenSpigetField" promptText="Custom User-Agent or Token" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
        </GridPane>
    </VBox>

    <Region VBox.vgrow="ALWAYS"/>

    <HBox spacing="10.0" alignment="CENTER_RIGHT">
        <Button fx:id="cancelBtn" text="取消" onAction="#handleCancel" styleClass="btn-secondary"/>
        <Button fx:id="saveBtn" text="儲存設定" onAction="#handleSave" styleClass="btn-primary"/>
    </HBox>
</VBox>
