<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.sparxilium.smartpluginassistant.controller.AddByUrlDialogController"
      spacing="14.0" prefWidth="560.0" style="-fx-background-color: #1e1f22; -fx-padding: 20;">

    <Label fx:id="titleLabel" text="透過 Modrinth 網址新增插件" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #ffffff;"/>
    <Label fx:id="hintLabel" text="輸入 Modrinth 插件頁面網址 (例如: https://modrinth.com/plugin/viaversion) 或專案 ID" style="-fx-text-fill: #8b8e96; -fx-font-size: 12px;" wrapText="true"/>

    <HBox spacing="8.0" alignment="CENTER_LEFT">
        <TextField fx:id="urlField" promptText="https://modrinth.com/plugin/..." HBox.hgrow="ALWAYS" onAction="#handleResolve"/>
        <Button fx:id="resolveBtn" text="解析" onAction="#handleResolve" styleClass="btn-primary"/>
    </HBox>

    <HBox alignment="CENTER">
        <ProgressIndicator fx:id="progressIndicator" prefWidth="24" prefHeight="24" visible="false"/>
    </HBox>

    <!-- Preview Container -->
    <VBox fx:id="previewContainer" spacing="10.0" styleClass="instance-card" visible="false">
        <HBox spacing="12.0" alignment="CENTER_LEFT">
            <ImageView fx:id="iconView" fitWidth="44" fitHeight="44"/>
            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                <Label fx:id="projectTitleLabel" style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #ffffff;"/>
                <Label fx:id="authorLabel" style="-fx-text-fill: #8b8e96; -fx-font-size: 11px;"/>
            </VBox>
        </HBox>
        <Label fx:id="descLabel" style="-fx-text-fill: #bcbec4; -fx-font-size: 12px;" wrapText="true"/>
        <Label fx:id="targetVersionLabel" style="-fx-text-fill: #2ecc71; -fx-font-weight: bold; -fx-font-size: 12px;"/>
        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <Button fx:id="downloadBtn" text="下載並安裝至實例" onAction="#handleDownload" styleClass="btn-success"/>
        </HBox>
    </VBox>

    <HBox spacing="10.0" alignment="CENTER_RIGHT">
        <Button fx:id="closeBtn" text="關閉" onAction="#handleClose" styleClass="btn-secondary"/>
    </HBox>
</VBox>
