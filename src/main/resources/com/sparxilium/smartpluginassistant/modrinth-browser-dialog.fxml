<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.sparxilium.smartpluginassistant.controller.ModrinthBrowserController"
      spacing="12.0" prefWidth="960.0" prefHeight="650.0" style="-fx-background-color: #1e1f22; -fx-padding: 16;">

    <HBox spacing="10.0" alignment="CENTER_LEFT">
        <Label fx:id="titleLabel" text="Modrinth 插件中心" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #ffffff;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <ProgressIndicator fx:id="loadingIndicator" prefWidth="20" prefHeight="20" visible="false"/>
    </HBox>

    <!-- Filter Bar -->
    <HBox spacing="10.0" alignment="CENTER_LEFT">
        <TextField fx:id="searchField" promptText="搜尋插件名稱或關鍵字 (例如: viaversion, essentials...)" HBox.hgrow="ALWAYS" onAction="#handleSearch"/>
        <ComboBox fx:id="loaderFilterCombo" prefWidth="130"/>
        <ComboBox fx:id="versionFilterCombo" prefWidth="120"/>
        <CheckBox fx:id="ignoreVersionCheckBox" text="無視版本檢查" style="-fx-text-fill: #dfe1e5; -fx-font-weight: bold;"/>
        <Button fx:id="searchBtn" text="搜尋" onAction="#handleSearch" styleClass="btn-primary"/>
    </HBox>

    <HBox alignment="CENTER_LEFT">
        <Label fx:id="statusLabel" text="準備就緒" style="-fx-text-fill: #8b8e96; -fx-font-size: 12px;"/>
    </HBox>

    <SplitPane dividerPositions="0.65" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
        <!-- Left Side: Results List -->
        <ScrollPane fx:id="resultsScrollPane" fitToWidth="true" style="-fx-background: #18191c; -fx-background-color: #18191c;">
            <VBox fx:id="resultsContainer" spacing="10.0" style="-fx-padding: 8;"/>
        </ScrollPane>

        <!-- Right Side: Details View like Prism Launcher -->
        <VBox fx:id="detailContainer" spacing="14.0" style="-fx-padding: 14; -fx-background-color: #2b2d30; -fx-background-radius: 6;" visible="false">
            <Label fx:id="detailTitleLabel" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #ffffff;" wrapText="true"/>
            <Label fx:id="detailAuthorLabel" style="-fx-text-fill: #8b8e96; -fx-font-size: 12px;"/>
            
            <Separator style="-fx-background-color: #393b40;"/>
            
            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-background: transparent;">
                <Label fx:id="detailDescLabel" style="-fx-text-fill: #dfe1e5; -fx-font-size: 13px;" wrapText="true"/>
            </ScrollPane>

            <Separator style="-fx-background-color: #393b40;"/>

            <!-- Version Selector Area -->
            <VBox spacing="6.0">
                <Label text="選擇版本 (Select Version):" style="-fx-text-fill: #ffffff; -fx-font-weight: bold;"/>
                <ComboBox fx:id="detailVersionCombo" maxWidth="Infinity"/>
            </VBox>

            <Button fx:id="detailInstallBtn" text="下載並安裝" maxWidth="Infinity" styleClass="btn-success" onAction="#handleInstallSelectedVersion"/>
        </VBox>
    </SplitPane>
</VBox>
