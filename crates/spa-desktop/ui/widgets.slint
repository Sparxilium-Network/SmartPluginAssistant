import { Theme } from "theme.slint";
import { ScrollView } from "std-widgets.slint";

// The hover hint currently shown. Buttons write it; MainWindow draws it above everything, so it
// is never clipped or covered by later siblings. An empty text hides it.
export global Tip {
    in-out property <string> text;
    // Anchor rectangle of the hovered control, in window coordinates.
    in-out property <length> x;
    in-out property <length> y;
    in-out property <length> anchor-height;
}

export component AppButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    // Explanation shown after the pointer rests on the button; empty for none.
    in property <string> tip;
    // Shows a drop-down arrow after the label.
    in property <bool> dropdown: false;
    property <bool> tip-shown;
    callback clicked();

    function hide-tip() {
        root.tip-shown = false;
        if (Tip.text == root.tip) {
            Tip.text = "";
        }
    }
    min-height: 34px;
    border-radius: 6px;
    opacity: root.enabled ? 1 : 0.45;
    background: root.primary
        ? (touch.has-hover && root.enabled ? Theme.accent-hover : Theme.accent)
        : root.danger ? Theme.danger-bg : (touch.has-hover && root.enabled ? Theme.hover : Theme.header);
    HorizontalLayout {
        padding-left: 13px;
        padding-right: 13px;
        Text {
            text: root.text;
            color: root.primary ? Theme.on-accent : root.danger ? Theme.danger : Theme.text;
            font-weight: root.primary ? 700 : 400;
            font-size: 13px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        // Drop-down indicator, drawn so it does not depend on font coverage.
        if root.dropdown: Rectangle {
            width: 18px;
            Path {
                x: 8px;
                y: (parent.height - 5px) / 2;
                width: 9px;
                height: 5px;
                viewbox-width: 9;
                viewbox-height: 5;
                commands: "M 0.5 0.5 L 4.5 4.5 L 8.5 0.5";
                stroke: Theme.muted;
                stroke-width: 1.5px;
            }
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            root.hide-tip();
            root.clicked();
        }
        changed has-hover => {
            if (!self.has-hover) {
                root.hide-tip();
            }
        }
    }
    // Hover hints work on disabled buttons too, where the explanation helps most.
    hover := TouchArea {
        enabled: !root.enabled;
        changed has-hover => {
            if (!self.has-hover) {
                root.hide-tip();
            }
        }
    }
    Timer {
        interval: 600ms;
        running: root.tip != "" && !root.tip-shown && (touch.has-hover || hover.has-hover);
        triggered => {
            root.tip-shown = true;
            Tip.x = root.absolute-position.x;
            Tip.y = root.absolute-position.y;
            Tip.anchor-height = root.height;
            Tip.text = root.tip;
        }
    }
}

// Floating hint box; positioned by MainWindow from `Tip`.
export component TipBox inherits Rectangle {
    in property <string> text;
    width: min(label.preferred-width + 20px, 340px);
    height: layout.preferred-height;
    background: Theme.title;
    border-radius: 6px;
    drop-shadow-blur: 10px;
    drop-shadow-color: #00000050;
    layout := VerticalLayout {
        padding-left: 10px;
        padding-right: 10px;
        padding-top: 7px;
        padding-bottom: 7px;
        label := Text {
            text: root.text;
            color: Theme.bg;
            font-size: 12px;
            wrap: word-wrap;
        }
    }
}

// One entry of a drop-down menu: a title with a muted explanation underneath.
export component MenuItem inherits Rectangle {
    in property <string> text;
    in property <string> detail;
    callback clicked();
    height: layout.preferred-height;
    border-radius: 6px;
    background: touch.has-hover ? Theme.hover : transparent;
    layout := VerticalLayout {
        padding: 10px;
        spacing: 3px;
        Text { text: root.text; color: Theme.text; font-size: 13px; font-weight: 700; }
        Text { text: root.detail; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component Badge inherits Rectangle {
    in property <string> text;
    background: Theme.badge-bg;
    border-radius: 5px;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        padding-top: 3px;
        padding-bottom: 3px;
        Text { text: root.text; color: Theme.badge-text; font-size: 11px; vertical-alignment: center; }
    }
}

// Project artwork with an initial-letter placeholder when no image is available.
export component Artwork inherits Rectangle {
    in property <image> source;
    in property <bool> loaded: false;
    in property <string> initial;
    background: Theme.icon-bg;
    border-radius: 8px;
    clip: true;
    if !root.loaded: Text {
        text: root.initial;
        color: Theme.text;
        font-size: root.height * 0.42;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if root.loaded: Image {
        source: root.source;
        width: root.width;
        height: root.height;
        image-fit: contain;
    }
}

export component Muted inherits Text {
    color: Theme.muted;
    font-size: 12px;
    wrap: word-wrap;
}

export component SectionTitle inherits Text {
    color: Theme.title;
    font-size: 15px;
    font-weight: 700;
}

// Modal overlay: dims the window and centers a panel. Clicks outside are swallowed.
export component Modal inherits Rectangle {
    in property <string> title;
    in property <length> panel-width: 560px;
    background: Theme.scrim;
    TouchArea { }
    panel := Rectangle {
        width: min(root.panel-width, root.width - 40px);
        height: min(layout.preferred-height, root.height - 40px);
        background: Theme.surface;
        border-radius: 10px;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000060;
        layout := VerticalLayout {
            padding: 20px;
            spacing: 14px;
            Text { text: root.title; color: Theme.title; font-size: 18px; font-weight: 700; }
            @children
        }
    }
}

// Scrollable multi-line text block for long messages.
export component TextBlock inherits ScrollView {
    in property <string> text;
    in property <color> color: Theme.text;
    min-height: min(content.preferred-height, 80px);
    preferred-height: min(content.preferred-height, 320px);
    content := VerticalLayout {
        width: root.visible-width;
        Text {
            text: root.text;
            color: root.color;
            wrap: word-wrap;
            font-size: 13px;
        }
    }
}
